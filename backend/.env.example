GROQ_API_KEY=your-groq-api-key-here
JWT_SECRET=change-this-to-a-real-random-secret-before-deploy
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:6262

# Optional. Leave unset for local dev — defaults to a local SQLite file.
# On Render, this is injected automatically once a Postgres database is
# linked to the service; no need to set it by hand there.
# DATABASE_URL=postgresql://user:password@host:5432/dbname
